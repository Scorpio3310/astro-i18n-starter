---
// Imports
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import Base from "@layouts/Base.astro";
import { Image } from "astro:assets";
import { formatDate } from "@utils/utils";
import "@styles/markdown.css";

// Get current language from URL and generate paths for each blog post
export const getStaticPaths = (async () => {
    // Fetch all blog posts and authors
    const posts = await getCollection("blog", (entry) => !entry.data.isDraft);
    const authorsRaw = await getCollection("authors");

    // Define language configurations
    // [blog] holds a single segment ("blog" or the "sl" prefix),
    // [...slug] holds the rest: "<slug>" or "spletni-dnevnik/<slug>"
    const langConfigs = {
        en: { prefix: "en/", blog: "blog", slugPrefix: "" },
        sl: { prefix: "sl/", blog: "sl", slugPrefix: "spletni-dnevnik/" },
    };

    // Create paths for each post in each language
    const createPath = (
        post: (typeof posts)[number],
        lang: "en" | "sl",
        blog: string,
        slugPrefix: string,
    ) => {
        const author = authorsRaw.find((a) => a.id === post.data.author.id);
        const localizedAuthor = author && {
            ...author,
            data: {
                ...author.data,
                position:
                    author.data.position?.[lang] ??
                    author.data.position?.en ??
                    "",
            },
        };

        return {
            params: { blog, slug: `${slugPrefix}${post.id.split("/")[1]}` },
            props: { post, lang, author: localizedAuthor },
        };
    };

    // Generate and return all paths
    return Object.entries(langConfigs).flatMap(
        ([lang, { prefix, blog, slugPrefix }]) =>
            posts
                .filter((post) => post.id.startsWith(prefix))
                .map((post) =>
                    createPath(post, lang as "en" | "sl", blog, slugPrefix)
                )
    );
}) satisfies GetStaticPaths;

// Props
const { post, author, lang } = Astro.props;

// Render the MD content of the blog post
const { Content } = await render(post);
---

<Base
    title={post?.data?.title}
    meta={{
        description: post?.data?.description,
        keywords: post?.data?.keywords,
        image: post?.data?.image?.src,
    }}
>
    <section aria-labelledby="article-title">
        <article
            aria-labelledby="article-title"
            aria-describedby="article-meta"
        >
            {/* Main article image (above the fold: priority sets eager/sync/high) */}
            <Image
                src={post?.data?.image}
                alt={post.data.imageAlt || post.data.title}
                class="mb-10"
                priority
                quality={"high"}
                layout="constrained"
                width={768}
                transition:name={`${post.data.title}-image`}
            />

            <!--Article Title-->
            <h1 id="article-title" class="!text-left">
                {post?.data?.title}
            </h1>

            <div id="article-meta" class="author-time">
                {
                    author && (
                        <div class="author" role="group">
                            <Image
                                src={author.data.image}
                                alt={author.data.name}
                                height={36}
                                width={36}
                                layout="fixed"
                                quality={"high"}
                                class="rounded-full"
                            />
                            <div>
                                <h3>{author.data.name}</h3>
                                <p
                                    class="position"
                                    aria-label={`${author.data.position}`}
                                >
                                    {author.data.position}
                                </p>
                            </div>
                        </div>
                    )
                }
                <time
                    class="date"
                    datetime={post.data.pubDate.toISOString()}
                    aria-label={`${formatDate(post.data.pubDate, lang)}`}
                >
                    {formatDate(post.data.pubDate, lang)}
                </time>
            </div>

            <!--Markdown Content-->
            <section class="md-content">
                <Content />
            </section>
        </article>
    </section>
</Base>
